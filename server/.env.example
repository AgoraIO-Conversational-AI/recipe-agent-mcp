AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! Ask me what time it is.
MCP_ENDPOINT=https://<your-tunnel>/mcp
OPENAI_MODEL=gpt-4o-mini
# Pipeline is Agora-managed by default. Set a key for BYO; override the URL if needed.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# Realtime mode uses a separate OpenAI API key.
# OPENAI_REALTIME_API_KEY=sk-your-openai-key
# OPENAI_REALTIME_MODEL=gpt-realtime
